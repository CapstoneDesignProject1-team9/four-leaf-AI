# Google Gemini (합성 데이터 생성 등 기존 별도 기능용)
GOOGLE_API_KEY=replace_with_your_google_api_key

# 교수자 어드바이저는 Claude를 사용합니다(ANTHROPIC_API_KEY 필요). 기본 모델: claude-opus-5-5
# ADVISOR_MODEL=claude-opus-5-5

# Claude evaluation (judge scoring and RAGAS metrics)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional override for the RAGAS judge model; defaults to ANTHROPIC_MODEL
# RAGAS_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# vLLM LoRA evaluation (mount adapters under models/student-lora and models/professor-lora)
VLLM_CHAT_COMPLETIONS_URL=http://localhost:8001/v1/chat/completions
VLLM_MODELS_URL=http://localhost:8001/v1/models
RAG_API_URL=http://localhost:8000/api/v1/tutor/chat
VLLM_BASE_URL=http://localhost:8001
VLLM_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_LORA_ADAPTERS={"student-lora":"student-lora","professor-lora":"professor-lora"}
VLLM_STUDENT_LORA_MODEL_NAME=student-lora
VLLM_PROFESSOR_LORA_MODEL_NAME=professor-lora
VLLM_MAX_TOKENS=768

# RAG answer generation also uses vLLM (temperature 0); VLLM_BASE_URL has no /v1 suffix
VLLM_TIMEOUT_S=180

# FastAPI service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]

# PostgreSQL (local development; Docker Compose overrides DB_HOST to "db")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fourleaf_dev
DB_USER=fourleaf
DB_PASSWORD=devpassword

# ChromaDB and embedding settings (defaults shown)
CHROMA_PERSIST_DIR=./knowledge/vectorstores/knu_notice_bge_m3
CHROMA_COLLECTION_NAME=knu_notices_bge_m3_v1
CHROMA_SYLLABI_PERSIST_DIR=./knowledge/vectorstores/knu_syllabi_bge_m3
CHROMA_SYLLABI_COLLECTION_NAME=knu_syllabi_bge_m3_v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_MODEL_CACHE_DIR=./.cache/embedding_models
EMBEDDING_DEVICE=cpu
EMBEDDING_CPU_THREADS=4
RAG_TOP_K=5

# Spring backend and optional LangChain tracing
BACKEND_BASE_URL=http://localhost:8080
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=four-leaf-ai
