# Google Gemini
GOOGLE_API_KEY=replace_with_your_google_api_key
# Optional: override the model configured in app/core/config.py
# GEMINI_MODEL=your_supported_gemini_model

# FastAPI service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]

# PostgreSQL (local development; Docker Compose overrides DB_HOST to "db")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fourleaf_dev
DB_USER=fourleaf
DB_PASSWORD=devpassword

# ChromaDB and embedding settings (defaults shown)
CHROMA_PERSIST_DIR=./knowledge/vectorstores/knu_bge_m3
CHROMA_COLLECTION_NAME=knu_notices_bge_m3_v1
CHROMA_SYLLABI_PERSIST_DIR=./knowledge/vectorstores/knu_syllabi_bge_m3
CHROMA_SYLLABI_COLLECTION_NAME=knu_syllabi_bge_m3_v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_MODEL_CACHE_DIR=./.cache/embedding_models
EMBEDDING_DEVICE=cpu
EMBEDDING_CPU_THREADS=4
RAG_TOP_K=5

# Spring backend and optional LangChain tracing
BACKEND_BASE_URL=http://localhost:8080
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=four-leaf-ai
